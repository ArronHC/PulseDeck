# Fast CI Dockerfile for pre-built multi-arch binaries (used by GitHub Actions).
FROM alpine:3.21

WORKDIR /app

ARG TARGETOS
ARG TARGETARCH

RUN apk add --no-cache ca-certificates curl tzdata \
 && mkdir -p /app/data

COPY --chmod=755 komari-${TARGETOS}-${TARGETARCH} /app/komari

ENV GIN_MODE=release
ENV KOMARI_LISTEN=0.0.0.0:25774
ENV GODEBUG=disablethp=1
ENV TZ=Asia/Shanghai

VOLUME ["/app/data"]
EXPOSE 25774

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS http://127.0.0.1:25774/ping >/dev/null 2>&1 || curl -fsS http://127.0.0.1:25774/api/install/status >/dev/null 2>&1 || exit 1

CMD ["/app/komari", "server"]
